@model TiendaOnline.Application.DTOs.OrderDto

@{
    ViewData["Title"] = "Eliminar Orden";
}

<h1>Eliminar Orden</h1>

<h3>¿Estás seguro de que deseas eliminar esta orden?</h3>
<div>
    <h4>Orden</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            ID
        </dt>
        <dd class="col-sm-10">
            @Model.OrderId
        </dd>
        <dt class="col-sm-2">
            Fecha
        </dt>
        <dd class="col-sm-10">
            @Model.Date.ToString("dd/MM/yyyy")
        </dd>
        <dt class="col-sm-2">
            Estado
        </dt>
        <dd class="col-sm-10">
            @Model.Status
        </dd>
        <dt class="col-sm-2">
            Usuario
        </dt>
        <dd class="col-sm-10">
            @Model.UserId
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="OrderId" />
        <div class="form-group">
            <input type="submit" value="Eliminar" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </div>
    </form>
</div>

