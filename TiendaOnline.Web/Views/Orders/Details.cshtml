@model TiendaOnline.Application.DTOs.OrderDto

@{
    ViewData["Title"] = "Detalles del Pedido";
}

<div class="container mt-4">
    <h1>Detalles del Pedido</h1>
    <div class="row">
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Información del Pedido</h4>
                </div>
                <div class="card-body">
                    <p><strong>Número de Pedido:</strong> @Model.OrderId</p>
                    <p><strong>Fecha:</strong> @Model.Date.ToShortDateString()</p>
                    <p><strong>Estado:</strong> @Model.Status</p>
                    <p><strong>Total:</strong> @Model.Total.ToString("C")</p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h4>Productos del Pedido</h4>
                </div>
                <div class="card-body">
                    @if (Model.OrderProducts?.Any() == true)
                    {
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Precio</th>
                                    <th>Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var product in Model.OrderProducts)
                                {
                                    <tr>
                                        <td>@product.ProductName</td>
                                        <td>@product.Quantity</td>
                                        <td>@product.Price.ToString("C")</td>
                                        <td>@(product.Quantity * product.Price).ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p>No hay productos en este pedido.</p>
                    }
                </div>
            </div>
        </div>
    </div>
    <a href="@Url.Action("Profile", "Account")" class="btn btn-secondary mt-2">Volver al Perfil</a>
</div>
