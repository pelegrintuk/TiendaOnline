@model IEnumerable<TiendaOnline.Application.DTOs.OrderDto>

@{
    ViewData["Title"] = "Gestión de Órdenes";
}

<h1>Gestión de Órdenes</h1>

<table class="table table-striped table-hover">
    <thead class="thead-dark">
        <tr>
            <th>ID</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Usuario</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.Date.ToString("dd/MM/yyyy")</td>
                <td>@order.Status</td>
                <td>@order.UserId</td>
                <td>
                    <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-info">Detalles</a>
                    <a asp-action="Edit" asp-route-id="@order.OrderId" class="btn btn-warning">Editar</a>
                    <a asp-action="Delete" asp-route-id="@order.OrderId" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
